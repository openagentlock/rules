{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openagentlock.github.io/rules/schema/rule.schema.json",
  "title": "OpenAgentLock community rule",
  "type": "object",
  "required": ["schema_version", "id", "name", "description", "severity", "gate"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
      "description": "Lowercase, dot-separated rule id, e.g. 'rogue.destructive-bash'."
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["github"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "github": { "type": "string", "pattern": "^[a-zA-Z0-9-]+$" }
        }
      }
    },
    "license": {
      "type": "string",
      "default": "Apache-2.0"
    },
    "compatible_agentlock": {
      "type": "string",
      "description": "semver range of OpenAgentLock daemon versions this rule has been tested against, e.g. '>=0.1.0'."
    },
    "gate": {
      "type": "object",
      "required": ["match", "evaluate"],
      "additionalProperties": false,
      "description": "OpenAgentLock-native gate block. Mirrors the shape used by the daemon's policy YAML so installs are a verbatim copy.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["monitor", "firewall"]
        },
        "disabled": {
          "type": "boolean"
        },
        "match": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "tool": { "type": "string" },
            "tool_prefix": { "type": "string" },
            "any_command_regex": {
              "type": "array",
              "items": { "type": "string" }
            },
            "any_path_regex": {
              "type": "array",
              "items": { "type": "string" }
            },
            "any_url_regex": {
              "type": "array",
              "items": { "type": "string" }
            },
            "path_glob": { "type": "string" }
          }
        },
        "evaluate": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "action"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["always", "allowlist", "typosquat"]
              },
              "action": {
                "type": "string",
                "enum": ["allow", "deny", "monitor", "warn"]
              },
              "nudge": {
                "type": "string",
                "maxLength": 2000,
                "description": "Optional human-readable hint surfaced alongside the verdict. The daemon pipes this through to the agent harness so the model can recover (e.g. 'use trash instead of rm -rf'). Plain text, typically 1–4 sentences."
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  }
}
